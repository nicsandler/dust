  "license": "ISC",
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.0.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.0.0",
    "firebase-functions": "^6.3.2",
    "raw-body": "4.0.0"
  },
  "overrides": {
    "protobufjs@<8.8.0": "8.8.0",
    "yargs@<18.1.0": "18.1.0",
    "uuid@<11.1.1": "11.1.1",
    "raw-body": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "globals": "^15.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
