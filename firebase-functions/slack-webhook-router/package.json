{
  "name": "slack-webhook-router",
  "version": "1.0.0",
  "description": "Slack webhook router for multi-region deployment.",
  "type": "module",
  "main": "dist/firebase.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && firebase emulators:start --only functions",
